# Application
APP_ENV=development
LOG_LEVEL=INFO

# Configurable model access through the shared LangChain model factory
MODEL_PROVIDER=
MODEL_NAME=
MODEL_BASE_URL=
MODEL_API_KEY=

# Authentication. The app refuses to start without CHAINLIT_AUTH_SECRET (at least 32
# characters; generate with `uv run chainlit create-secret`). An account whose password
# is empty cannot sign in. User ids live in config/access.toml.
CHAINLIT_AUTH_SECRET=
AUTH_PASSWORD_U_RO_01=
AUTH_PASSWORD_U_PM_01=
AUTH_PASSWORD_U_FIN_01=

# PostgreSQL
POSTGRES_DB=supplyguard
POSTGRES_USER=supplyguard
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://supplyguard:change-me@127.0.0.1:5432/supplyguard

# Neo4j
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# ChromaDB
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8001

# MCP services
PROCUREMENT_MCP_URL=http://127.0.0.1:8100
EXTERNAL_RISK_MCP_URL=http://127.0.0.1:8101/mcp
EXTERNAL_RISK_FEED_URL=http://127.0.0.1:8003
EXTERNAL_RISK_MCP_HOST=127.0.0.1
EXTERNAL_RISK_MCP_PORT=8101

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=supplyguard-ai
